&lt;/style&gt;&lt;/head&gt;&lt;body style=&quot; font-family:'Ubuntu Sans'; font-size:11pt; font-weight:400; font-style:normal;&quot;&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;Suggested Settings&lt;br /&gt;&lt;span style=&quot; font-size:10pt;&quot;&gt;Noise Detection &lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Verdana','Helvetica Neue','Helvetica','Arial','sans-serif'; font-size:14px; color:#58566d; background-color:#e9e9fd;&quot;&gt;     Δ&lt;/span&gt;&lt;span style=&quot; font-size:10pt;&quot;&gt; = 2.0, &lt;/span&gt;&lt;span style=&quot; font-family:'Verdana','Helvetica Neue','Helvetica','Arial','sans-serif'; font-size:14px; color:#58566d; background-color:#e9e9fd;&quot;&gt;Β&lt;/span&gt;&lt;span style=&quot; font-size:10pt;&quot;&gt; = 2.5&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-size:10pt;&quot;&gt;Spectral Bands&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Verdana','Helvetica Neue','Helvetica','Arial','sans-serif'; font-size:10pt; color:#58566d; background-color:#e9e9fd;&quot;&gt;     δ&lt;/span&gt;&lt;span style=&quot; font-size:10pt;&quot;&gt; :   0.5 -  4.0 Hz,      &lt;/span&gt;&lt;span style=&quot; font-family:'Verdana','Helvetica Neue','Helvetica','Arial','sans-serif'; font-size:10pt; color:#58566d; background-color:#e9e9fd;&quot;&gt;θ:   &lt;/span&gt;&lt;span style=&quot; font-size:10pt;&quot;&gt;4.0 -    8.0 Hz,&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Verdana','Helvetica Neue','Helvetica','Arial','sans-serif'; font-size:10pt; color:#58566d; background-color:#e9e9fd;&quot;&gt;     α:   &lt;/span&gt;&lt;span style=&quot; font-size:10pt;&quot;&gt;8.0 -12.0 Hz,      &lt;/span&gt;&lt;span style=&quot; font-family:'Verdana','Helvetica Neue','Helvetica','Arial','sans-serif'; font-size:10pt; color:#58566d; background-color:#e9e9fd;&quot;&gt;σ: &lt;/span&gt;&lt;span style=&quot; font-size:10pt;&quot;&gt;12.0 - 15.0 Hz,&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Verdana','Helvetica Neue','Helvetica','Arial','sans-serif'; font-size:10pt; color:#58566d; background-color:#e9e9fd;&quot;&gt;     β &lt;/span&gt;&lt;span style=&quot; font-size:10pt;&quot;&gt;15.0 - 30.0 Hz,      &lt;/span&gt;&lt;span style=&quot; font-family:'Verdana','Helvetica Neue','Helvetica','Arial','sans-serif'; font-size:10pt; color:#58566d; background-color:#e9e9fd;&quot;&gt;γ: &lt;/span&gt;&lt;span style=&quot; font-size:10pt;&quot;&gt;30.0 - 50.0 Hz&lt;/span&gt;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
              </property>
